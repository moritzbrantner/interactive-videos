{
  "name": "interactive-videos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "verify": "bun run check-types && bun run test && bun run test:render && bun run build && bun run test:budget",
    "build:budget": "vite build --mode render-budget --outDir .cache/budget-dist",
    "test:budget": "bun run build:pins && playwright test",
    "build:pins": "rm -rf .cache/pins/react-render-budget && mkdir -p .cache/pins/react-render-budget && cp -R node_modules/react-render-budget/src .cache/pins/react-render-budget/src",
    "video:render": "bun src/render/cli.ts",
    "narration:regenerate": "bun scripts/narration/regenerate-nicaea-325.ts"
  },
  "dependencies": {
    "@moritzbrantner/charts": "github:moritzbrantner/charts#a2288317f10d42b3b464b4d36d8727f03dfc9362",
    "@moritzbrantner/tables": "github:moritzbrantner/tables#c9a2a0a912810f8c2888eafdd6fd8c39e207a5d3",
    "asset-tooling": "github:moritzbrantner/asset-tooling#9a41b945ea788ae56d5daa61b03fb3a6caea4018",
    "@remotion/bundler": "4.0.537",
    "@remotion/captions": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react-render-budget": "github:moritzbrantner/react-render-budget#d9b033c0106b0f33a96e8fe101e07081af800ab1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
