{
  "name": "interactive-videos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "verify": "bun run check-types && bun run test && bun run test:render && bun run build && bun run test:budget",
    "build:budget": "vite build --mode render-budget --outDir .cache/budget-dist",
    "test:budget": "bun run build:pins && playwright test",
    "build:pins": "rm -rf .cache/pins/react-render-budget && mkdir -p .cache/pins/react-render-budget && cp -R node_modules/react-render-budget/src .cache/pins/react-render-budget/src",
    "video:render": "bun src/render/cli.ts",
    "narration:regenerate": "bun scripts/narration/regenerate-nicaea-325.ts"
  },
  "dependencies": {
    "@moritzbrantner/charts": "github:moritzbrantner/charts#9ca963a44f9e2769036d366434f282f857da24ae",
    "@moritzbrantner/tables": "github:moritzbrantner/tables#1173c132da01bf5cf1e5221a78f40ebe711420b8",
    "asset-tooling": "github:moritzbrantner/asset-tooling#063842b8ec26549d2ba36e474b3b516ea9ab1cd7",
    "@remotion/bundler": "4.0.535",
    "@remotion/captions": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react-render-budget": "github:moritzbrantner/react-render-budget#40896fe162d94daa0ead71a75f81e376c86b9877",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
