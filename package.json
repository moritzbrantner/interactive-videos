{
  "name": "interactive-videos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "verify": "bun run check-types && bun run test && bun run test:render && bun run build && bun run test:budget",
    "build:budget": "vite build --mode render-budget --outDir .cache/budget-dist",
    "test:budget": "bun run build:pins && playwright test",
    "build:pins": "rm -rf .cache/pins/react-render-budget && mkdir -p .cache/pins/react-render-budget && cp -R node_modules/react-render-budget/src .cache/pins/react-render-budget/src",
    "video:render": "bun src/render/cli.ts",
    "narration:regenerate": "bun scripts/narration/regenerate-nicaea-325.ts"
  },
  "dependencies": {
    "@moritzbrantner/charts": "github:moritzbrantner/charts#34a07cbeb5819dee954f1a33c4f75c28a737ca30",
    "@moritzbrantner/tables": "github:moritzbrantner/tables#08fa0c7f943328c68d5eecf38c0dfd158f35707a",
    "asset-tooling": "github:moritzbrantner/asset-tooling#1ecb671a696d2d06d8ccd0e4a354c7845e10f396",
    "@remotion/bundler": "4.0.543",
    "@remotion/captions": "4.0.543",
    "@remotion/player": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react-render-budget": "github:moritzbrantner/react-render-budget#888821326b763de8ea391aefc8a2563980342a4c",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
