{
  "name": "interactive-videos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run check-types && bun run test && bun run build && bun run test:budget",
    "build:budget": "vite build --mode render-budget --outDir .cache/budget-dist",
    "test:budget": "bun run build:pins && playwright test",
    "build:pins": "rm -rf .cache/pins/react-render-budget && mkdir -p .cache/pins/react-render-budget && cp -R node_modules/react-render-budget/src .cache/pins/react-render-budget/src"
  },
  "dependencies": {
    "@moritzbrantner/charts": "github:moritzbrantner/charts#053da9ddd133d62e65f9f1e9e95ecc8b7624623f",
    "@moritzbrantner/tables": "github:moritzbrantner/tables#7ede19a0e8db00b924641c241ae8b424574e874a",
    "@remotion/captions": "4.0.534",
    "@remotion/player": "4.0.534",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "react-render-budget": "github:moritzbrantner/react-render-budget#db67f7c16201d67a247e491565ce01b51ad778d4",
    "typescript": "^6.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.8"
  }
}
