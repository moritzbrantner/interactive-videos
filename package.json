{
  "name": "interactive-videos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "verify": "bun run check-types && bun run test && bun run test:render && bun run build && bun run test:budget",
    "build:budget": "vite build --mode render-budget --outDir .cache/budget-dist",
    "test:budget": "bun run build:pins && playwright test",
    "build:pins": "rm -rf .cache/pins/react-render-budget && mkdir -p .cache/pins/react-render-budget && cp -R node_modules/react-render-budget/src .cache/pins/react-render-budget/src",
    "video:render": "bun src/render/cli.ts",
    "narration:regenerate": "bun scripts/narration/regenerate-nicaea-325.ts"
  },
  "dependencies": {
    "@moritzbrantner/charts": "github:moritzbrantner/charts#78217ce04ea21f0ccb8d41b116d7ea173343ac2e",
    "@moritzbrantner/tables": "github:moritzbrantner/tables#50c15190886f57ab4dbb1d30fef3097d7bf3dfe8",
    "asset-tooling": "github:moritzbrantner/asset-tooling#b03c04601ee53373459faf9d919e75013bf99904",
    "@remotion/bundler": "4.0.539",
    "@remotion/captions": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react-render-budget": "github:moritzbrantner/react-render-budget#95694af86ea53edb833f710c1a71e91f8acca534",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
