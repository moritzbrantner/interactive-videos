{
  "name": "interactive-videos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "verify": "bun run check-types && bun run test && bun run test:render && bun run build && bun run test:budget",
    "build:budget": "vite build --mode render-budget --outDir .cache/budget-dist",
    "test:budget": "bun run build:pins && playwright test",
    "build:pins": "rm -rf .cache/pins/react-render-budget && mkdir -p .cache/pins/react-render-budget && cp -R node_modules/react-render-budget/src .cache/pins/react-render-budget/src",
    "video:render": "bun src/render/cli.ts",
    "narration:regenerate": "bun scripts/narration/regenerate-nicaea-325.ts"
  },
  "dependencies": {
    "@moritzbrantner/charts": "github:moritzbrantner/charts#d45b69c465bc0db70597975b8166433711b7210d",
    "@moritzbrantner/tables": "github:moritzbrantner/tables#4071f37f41987035af93534210ec2d77bc191212",
    "asset-tooling": "github:moritzbrantner/asset-tooling#b83f077226eb009b709061e6d2f0ad9d09336cca",
    "@remotion/bundler": "4.0.536",
    "@remotion/captions": "4.0.536",
    "@remotion/player": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react-render-budget": "github:moritzbrantner/react-render-budget#208f832f623b2ddf634f6334488b98aa8e56d021",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
