{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@moritzbrantner/charts/density": [
        "./node_modules/@moritzbrantner/charts/src/density.ts"
      ],
      "@moritzbrantner/tables/table": [
        "./node_modules/@moritzbrantner/tables/src/table.tsx"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "source-pins.ts"
  ]
}
